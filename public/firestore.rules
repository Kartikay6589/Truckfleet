rules_version = '2';

// Every account's data lives under users/{uid}/... — these rules make sure
// a signed-in user can only ever read or write their OWN documents, and
// nobody who isn't signed in can touch anything.
//
// Driver linkage: a Fleet Owner's driver record (users/{ownerUid}/drivers/{id})
// is just a name+license until the actual driver signs up and claims a
// driverInvites/{email} doc the owner created for them. Once a trip is
// assigned to that driver's uid, a small carve-out below lets the driver
// read that ONE trip and flip its status — nothing else in the owner's
// account is ever exposed to them.
service cloud.firestore {
  match /databases/{database}/documents {
    // The one account allowed to approve/deny new Fleet Owner & Company
    // signups. Checked against the Auth token's own (verified) email, never
    // anything client-supplied, so this can't be spoofed by writing a
    // different "role" or "email" field into a user's own profile doc.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'adminapproval01@gmail.com';
    }

    match /users/{userId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;

      // The admin needs to see every account's approved/denied status to
      // list pending signups — this never grants write access to anything
      // but the approve/deny fields (see the update rule below).
      allow read: if isAdmin();

      // Role is chosen once at sign-up and locked from then on (see the
      // "I am a..." picker in index.html) — no update may ever change it,
      // even one crafted outside the app's own UI. approved/denied are
      // likewise off-limits to the account itself — only the admin rule
      // below may ever flip those, otherwise a Fleet Owner could just
      // self-approve with a direct Firestore write.
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('approved', null) == resource.data.get('approved', null)
                    && request.resource.data.get('denied', null) == resource.data.get('denied', null);

      // The admin may only ever flip approved/denied on someone else's
      // profile — never their role, name, or anything else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'denied']);

      // Admin account management: see every account (already granted above)
      // and remove one entirely, including its data (see the subcollection
      // rule below) — never create or edit anyone's actual fleet data.
      allow delete: if isAdmin();

      // Recursive wildcard so the owner keeps full access to every nested
      // subcollection at any depth (vehicles, drivers, trips,
      // trips/{id}/expenses, trips/{id}/issues, trips/{id}/podSubmissions,
      // etc.) — the more specific driver-access rules below simply add to
      // this, they never take away from it.
      //
      // Requires at least one path segment (the subcollection name) before
      // the recursive part on purpose: {document=**} alone also matches
      // zero segments, i.e. the users/{userId} document itself, which would
      // silently undo the approved/denied lock above (a bare recursive
      // wildcard here would let an owner just write {approved:true} on
      // their own profile and skip admin approval entirely).
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Deleting an account (see the users/{userId} delete rule above)
        // also needs to clear out its vehicles/trips/etc., so the admin
        // can delete here too — but never create or edit any of it.
        allow read, delete: if isAdmin();
      }

      match /trips/{tripId} {
        // The assigned driver can see this one trip...
        allow read: if request.auth != null && resource.data.assignedDriverUid == request.auth.uid;
        // ...and can only ever change its status, never any money/route field.
        allow update: if request.auth != null
                      && resource.data.assignedDriverUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['driverStatus', 'driverStatusUpdatedAt']);

        // Driver can log expenses / report issues / submit a POD against a
        // trip assigned to them — write-once records, never edited or
        // deleted from the driver side, and readable only by the driver who
        // owns them (the owner already has full access via the recursive
        // rule above).
        match /expenses/{expenseId} {
          allow read, create: if request.auth != null
            && get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.assignedDriverUid == request.auth.uid;
        }
        match /issues/{issueId} {
          allow read, create: if request.auth != null
            && get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.assignedDriverUid == request.auth.uid;
        }
        match /podSubmissions/{podId} {
          allow read, create: if request.auth != null
            && get(/databases/$(database)/documents/users/$(userId)/trips/$(tripId)).data.assignedDriverUid == request.auth.uid;
        }
      }
    }

    // A Fleet Owner creates one of these when adding a driver with an email;
    // the invited email's own account is the only one that may ever claim
    // it (set driverUid once), and only while it's still unclaimed.
    match /driverInvites/{email} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || request.auth.token.email.lower() == email);
      allow update: if request.auth != null
        && request.auth.token.email.lower() == email
        && resource.data.driverUid == null
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.driverId == resource.data.driverId;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
