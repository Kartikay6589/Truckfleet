# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Twilio (optional). Leave the placeholder values to run in local/demo mode:
# OTPs are printed to this server's console and shown on-screen instead of
# sent by SMS.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

PORT=3000

# Signs login tokens (JWT). Required. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone with this value can forge a valid login for any account — keep it secret.
JWT_SECRET=
