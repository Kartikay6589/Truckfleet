# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# ── Database (Supabase Postgres) ──
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use the "Session pooler" or "Transaction pooler" string if your host has a
# limited connection count (e.g. a small Render instance); otherwise the
# direct connection string works fine too.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres

# ── CORS ──
# Your deployed frontend's origin (e.g. the Vercel URL), so the browser is
# allowed to call this API from a different domain. Comma-separate multiple
# origins. Leave as "*" for local development.
CORS_ORIGIN=*

# ── Twilio (optional) ──
# Leave the placeholder values to run in local/demo mode: OTPs are printed to
# this server's console and shown on-screen instead of sent by SMS.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Render sets this automatically — only needed for local dev.
PORT=3000

# Signs login tokens (JWT). Required. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone with this value can forge a valid login for any account — keep it secret.
JWT_SECRET=
